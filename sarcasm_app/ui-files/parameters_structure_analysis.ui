<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>735</width>
    <height>1580</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0" colspan="2">
    <widget class="QPushButton" name="btn_analyze_structure">
     <property name="toolTip">
      <string>&lt;p&gt;Runs steps 1 to 5 one after another (detect sarcomeres, analyse Z-bands, sarcomere vectors, myofibrils, domains) on the selected frames, with the parameters currently set below, so check them first. The optional 3D U-Net for high-speed movies is not part of it. On long movies this can take a while.&lt;/p&gt;</string>
     </property>
     <property name="text">
      <string>Run full structure analysis</string>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="label_4">
     <property name="toolTip">
      <string>&lt;p&gt;Frames the structure steps analyse: 'all', one frame (3), frames separated by commas (0, 4, 9) or ranges (0-99, both ends included). Frames start at 0.&lt;/p&gt;&lt;p&gt;Steps 2 to 5 can only analyse frames that step 1 has detected, and myofibrils and domains only frames that have sarcomere vectors. Results are saved under their frame numbers. The 3D U-Net ignores this and always runs on the whole movie.&lt;/p&gt;</string>
     </property>
     <property name="text">
      <string>Frames</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="QLineEdit" name="le_general_frames">
     <property name="toolTip">
      <string>&lt;p&gt;Frames the structure steps analyse: 'all', one frame (3), frames separated by commas (0, 4, 9) or ranges (0-99, both ends included). Frames start at 0.&lt;/p&gt;&lt;p&gt;Steps 2 to 5 can only analyse frames that step 1 has detected, and myofibrils and domains only frames that have sarcomere vectors. Results are saved under their frame numbers. The 3D U-Net ignores this and always runs on the whole movie.&lt;/p&gt;</string>
     </property>
     <property name="placeholderText">
      <string>all, single number or comma separated numbers</string>
     </property>
    </widget>
   </item>
   <item row="3" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox">
     <property name="enabled">
      <bool>true</bool>
     </property>
     <property name="title">
      <string>Sarcomere detection</string>
     </property>
     <property name="flat">
      <bool>false</bool>
     </property>
     <layout class="QFormLayout" name="formLayout_2">
      <property name="topMargin">
       <number>5</number>
      </property>
      <property name="bottomMargin">
       <number>5</number>
      </property>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout">
        <item>
         <widget class="QLineEdit" name="le_network">
          <property name="toolTip">
           <string>&lt;p&gt;2D U-Net used in step 1. 'auto' (default) picks a bundled model by pixel size: 'legacy' below 0.08 µm/px (high magnification, e.g. high-speed single-cell movies), the newer 'generalist' otherwise. Type 'generalist', 'generalist_v1' (the previous generalist model) or 'legacy' to force one, or use Browse… for your own trained weights (.pt). The models do not give identical numbers, so use one per study; the model used is saved with the results.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>auto</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_search_network">
          <property name="toolTip">
           <string>&lt;p&gt;Choose the .pt file of your own trained 2D U-Net; its path is written into the field. To go back to the bundled models, type 'auto' in the field.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Browse…</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_43">
          <property name="toolTip">
           <string>&lt;p&gt;Scales each image in x and y before the 2D U-Net and scales the predicted maps back afterwards (0.5 halves the resolution). Only meant to bring a pixel size the models were not trained for into their range (generalist 0.08–0.45 µm/px, legacy 0.06–0.35 µm/px); the log warns when the pixel size lies outside. Not a speed setting: the resampling costs Z-band localisation precision. Default 1.0 (off). Not used by the 3D U-Net.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Rescale factor</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_predict_rescale_factor">
          <property name="toolTip">
           <string>&lt;p&gt;Scales each image in x and y before the 2D U-Net and scales the predicted maps back afterwards (0.5 halves the resolution). Only meant to bring a pixel size the models were not trained for into their range (generalist 0.08–0.45 µm/px, legacy 0.06–0.35 µm/px); the log warns when the pixel size lies outside. Not a speed setting: the resampling costs Z-band localisation precision. Default 1.0 (off). Not used by the 3D U-Net.&lt;/p&gt;</string>
          </property>
          <property name="minimum">
           <double>0.100000000000000</double>
          </property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="decimals">
           <number>2</number>
          </property>
          <property name="maximum">
           <double>5.000000000000000</double>
          </property>
          <property name="singleStep">
           <double>0.100000000000000</double>
          </property>
          <property name="value">
           <double>1.000000000000000</double>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_9">
        <property name="toolTip">
         <string>&lt;p&gt;Largest tile (patch) the 2D U-Net processes at once; bigger images are split into tiles and the results stitched. Larger patches are faster and leave fewer seams but need more memory; if memory runs out, the prediction is retried with half the size. Multiples of 16 px. Only used when 'Auto' is off; default 1024 × 1024 px. A compute setting: apart from seams it does not change what is detected.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Max patch size [pixel]</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout_2">
        <item>
         <widget class="QCheckBox" name="chk_predict_auto_patch_size">
          <property name="toolTip">
           <string>&lt;p&gt;Chooses the patch size automatically from the free memory of the GPU (or CPU) and the model. An image that fits into one patch is then processed whole, which is usually faster and avoids stitching seams. On by default; uncheck to set width and height by hand.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Auto</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_11">
          <property name="toolTip">
           <string>&lt;p&gt;Largest tile (patch) the 2D U-Net processes at once; bigger images are split into tiles and the results stitched. Larger patches are faster and leave fewer seams but need more memory; if memory runs out, the prediction is retried with half the size. Multiples of 16 px. Only used when 'Auto' is off; default 1024 × 1024 px. A compute setting: apart from seams it does not change what is detected.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Width [px]:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sb_predict_size_width">
          <property name="toolTip">
           <string>&lt;p&gt;Largest tile (patch) the 2D U-Net processes at once; bigger images are split into tiles and the results stitched. Larger patches are faster and leave fewer seams but need more memory; if memory runs out, the prediction is retried with half the size. Multiples of 16 px. Only used when 'Auto' is off; default 1024 × 1024 px. A compute setting: apart from seams it does not change what is detected.&lt;/p&gt;</string>
          </property>
          <property name="maximum">
           <number>1000000</number>
          </property>
          <property name="singleStep">
           <number>16</number>
          </property>
          <property name="value">
           <number>512</number>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_10">
          <property name="toolTip">
           <string>&lt;p&gt;Largest tile (patch) the 2D U-Net processes at once; bigger images are split into tiles and the results stitched. Larger patches are faster and leave fewer seams but need more memory; if memory runs out, the prediction is retried with half the size. Multiples of 16 px. Only used when 'Auto' is off; default 1024 × 1024 px. A compute setting: apart from seams it does not change what is detected.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Height [px]:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sb_predict_size_height">
          <property name="toolTip">
           <string>&lt;p&gt;Largest tile (patch) the 2D U-Net processes at once; bigger images are split into tiles and the results stitched. Larger patches are faster and leave fewer seams but need more memory; if memory runs out, the prediction is retried with half the size. Multiples of 16 px. Only used when 'Auto' is off; default 1024 × 1024 px. A compute setting: apart from seams it does not change what is detected.&lt;/p&gt;</string>
          </property>
          <property name="maximum">
           <number>1000000</number>
          </property>
          <property name="singleStep">
           <number>16</number>
          </property>
          <property name="value">
           <number>512</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_12">
        <property name="toolTip">
         <string>&lt;p&gt;Before the U-Net sees an image, its intensities are stretched to the range 0–1. Min and Max are percentiles of the intensity histogram, taken over all frames being detected: everything below the Min percentile becomes black, everything above the Max percentile white. Defaults 0 % and 99.98 %. Change them only when detection is poor because of a few extremely bright spots or a high background.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Clip threshold intensity [%]</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout_3">
        <item>
         <widget class="QLabel" name="label_13">
          <property name="toolTip">
           <string>&lt;p&gt;Lower clip percentile for the intensity normalisation before the 2D U-Net. Intensities below this percentile (over all frames being detected) are set to black. Default 0 %, so only the darkest pixel is. Raising it pushes dim background to black.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Min:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_predict_clip_thresh_min">
          <property name="toolTip">
           <string>&lt;p&gt;Lower clip percentile for the intensity normalisation before the 2D U-Net. Intensities below this percentile (over all frames being detected) are set to black. Default 0 %, so only the darkest pixel is. Raising it pushes dim background to black.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>2</number>
          </property>
          <property name="maximum">
           <double>100.000000000000000</double>
          </property>
          <property name="value">
           <double>0.100000000000000</double>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_14">
          <property name="toolTip">
           <string>&lt;p&gt;Upper clip percentile for the intensity normalisation before the 2D U-Net. Intensities above this percentile (over all frames being detected) are set to white. Default 99.98 %, so only the brightest 0.02 % of pixels saturate. Lower it (e.g. to 99.5–99.9 %) when a few very bright spots, such as debris or saturated aggregates, make the sarcomeres look dim to the network.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Max:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_predict_clip_thresh_max">
          <property name="toolTip">
           <string>&lt;p&gt;Upper clip percentile for the intensity normalisation before the 2D U-Net. Intensities above this percentile (over all frames being detected) are set to white. Default 99.98 %, so only the brightest 0.02 % of pixels saturate. Lower it (e.g. to 99.5–99.9 %) when a few very bright spots, such as debris or saturated aggregates, make the sarcomeres look dim to the network.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>2</number>
          </property>
          <property name="maximum">
           <double>100.000000000000000</double>
          </property>
          <property name="value">
           <double>99.900000000000006</double>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QPushButton" name="btn_structure_predict">
        <property name="toolTip">
         <string>&lt;p&gt;Step 1. Runs the 2D U-Net on the selected frames and predicts, for every pixel, Z-bands, M-bands, sarcomere orientation, sarcomere area and cell area; cell area and intensity are measured right away. All later steps build on these maps, which are saved in the file's .ome.zarr store. Needs the pixel size. Uses the GPU if there is one; long movies can take minutes. Shows the Z-band map when done.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>1. Detect sarcomeres</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QGroupBox" name="groupBox_fast_movie">
        <property name="toolTip">
         <string>&lt;p&gt;Optional, for high-speed movies (about six or more frames per contraction). A 3D U-Net predicts Z-bands from several consecutive frames at once, which makes sarcomere lengths less noisy from frame to frame. Its Z-bands replace the 2D ones in step 3 and in tracking; M-bands and orientation still come from step 1. Check its Z-bands on your own data before relying on them.&lt;/p&gt;</string>
        </property>
        <property name="title">
         <string>3D U-Net Z-bands for high-speed movies (advanced)</string>
        </property>
        <property name="checkable">
         <bool>true</bool>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <layout class="QFormLayout" name="formLayout_fast_movie">
         <item row="0" column="0" colspan="2">
          <widget class="QLabel" name="label_fast_movie_note">
           <property name="text">
            <string>&lt;b&gt;Note:&lt;/b&gt; for high-speed movies of beating cells only (about 6 or more frames per contraction). The default 3D model was trained on simulated movies and on recordings from three microscopes. Still check its Z-bands on a new type of data, and re-train it if they look wrong (see the 3D U-Net training tutorial). When run, its Z-bands replace the 2D ones for the vector analysis and tracking.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_29">
            <property name="toolTip">
             <string>&lt;p&gt;3D U-Net used for high-speed movies. 'generalist' (default) is the bundled model, trained on simulated movies and on recordings from several microscopes. Type 'legacy' for the older bundled 3D model, or use Browse… for a 3D U-Net you trained yourself (.pt). The two bundled models give slightly different trajectories, so use one per study.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Network model</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_4">
            <item>
             <widget class="QLineEdit" name="le_fast_movie_network_model">
              <property name="toolTip">
               <string>&lt;p&gt;3D U-Net used for high-speed movies. 'generalist' (default) is the bundled model, trained on simulated movies and on recordings from several microscopes. Type 'legacy' for the older bundled 3D model, or use Browse… for a 3D U-Net you trained yourself (.pt). The two bundled models give slightly different trajectories, so use one per study.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>generalist</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_fast_movie_search">
              <property name="toolTip">
               <string>&lt;p&gt;Choose the .pt file of a 3D U-Net you trained yourself; its path is written into the field. Type 'generalist' to go back to the bundled model.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Browse…</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_30">
            <property name="toolTip">
             <string>&lt;p&gt;Largest block (patch) the 3D U-Net processes at once: N frames × width × height. The movie is split into such blocks and the results stitched. Larger patches are faster but need more memory. Each size must be a multiple of 16 and is rounded up otherwise. Only used when 'Auto' is off; defaults 32 frames and 256 × 256 px.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Max patch size [pixel]</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_6">
            <item>
             <widget class="QCheckBox" name="chk_fast_movie_auto_patch_size">
              <property name="toolTip">
               <string>&lt;p&gt;Chooses the 3D patch size (frames × width × height) automatically from the free memory of the GPU (or CPU) and the model. Fewer, larger patches mean less redundant computation. On by default; uncheck to set the sizes by hand.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Auto</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_34">
              <property name="toolTip">
               <string>&lt;p&gt;Largest block (patch) the 3D U-Net processes at once: N frames × width × height. The movie is split into such blocks and the results stitched. Larger patches are faster but need more memory. Each size must be a multiple of 16 and is rounded up otherwise. Only used when 'Auto' is off; defaults 32 frames and 256 × 256 px.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Width [px]:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="sb_fast_movie_width">
              <property name="toolTip">
               <string>&lt;p&gt;Largest block (patch) the 3D U-Net processes at once: N frames × width × height. The movie is split into such blocks and the results stitched. Larger patches are faster but need more memory. Each size must be a multiple of 16 and is rounded up otherwise. Only used when 'Auto' is off; defaults 32 frames and 256 × 256 px.&lt;/p&gt;</string>
              </property>
              <property name="maximum">
               <number>9999999</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_33">
              <property name="toolTip">
               <string>&lt;p&gt;Largest block (patch) the 3D U-Net processes at once: N frames × width × height. The movie is split into such blocks and the results stitched. Larger patches are faster but need more memory. Each size must be a multiple of 16 and is rounded up otherwise. Only used when 'Auto' is off; defaults 32 frames and 256 × 256 px.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Height [px]:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="sb_fast_movie_height">
              <property name="toolTip">
               <string>&lt;p&gt;Largest block (patch) the 3D U-Net processes at once: N frames × width × height. The movie is split into such blocks and the results stitched. Larger patches are faster but need more memory. Each size must be a multiple of 16 and is rounded up otherwise. Only used when 'Auto' is off; defaults 32 frames and 256 × 256 px.&lt;/p&gt;</string>
              </property>
              <property name="maximum">
               <number>9999999</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_31">
              <property name="toolTip">
               <string>&lt;p&gt;Number of consecutive frames in one 3D patch, i.e. how long a stretch of the movie the network processes at once. Larger values are faster but need more memory. Multiple of 16 (rounded up otherwise); default 32. Only used when 'Auto' is off.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>N Frames:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="sb_fast_movie_n_frames">
              <property name="toolTip">
               <string>&lt;p&gt;Number of consecutive frames in one 3D patch, i.e. how long a stretch of the movie the network processes at once. Larger values are faster but need more memory. Multiple of 16 (rounded up otherwise); default 32. Only used when 'Auto' is off.&lt;/p&gt;</string>
              </property>
              <property name="maximum">
               <number>9999999</number>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_36">
            <property name="toolTip">
             <string>&lt;p&gt;Before the 3D U-Net sees the movie, its intensities are stretched to the range 0–1. Min and Max are percentiles of the intensity histogram of the whole movie: everything below Min becomes black, everything above Max white. Defaults 0 % and 99.98 %. Change them only when a few extremely bright spots or a high background spoil the prediction.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Clip threshold intensity [%]</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_7">
            <item>
             <widget class="QLabel" name="label_40">
              <property name="toolTip">
               <string>&lt;p&gt;Lower clip percentile for the intensity normalisation before the 3D U-Net. Intensities below this percentile of the whole movie are set to black. Default 0 %. Raising it pushes dim background to black.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Min:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QDoubleSpinBox" name="dsb_fast_movie_clip_thresh_min">
              <property name="toolTip">
               <string>&lt;p&gt;Lower clip percentile for the intensity normalisation before the 3D U-Net. Intensities below this percentile of the whole movie are set to black. Default 0 %. Raising it pushes dim background to black.&lt;/p&gt;</string>
              </property>
              <property name="maximum">
               <double>999999999.000000000000000</double>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_39">
              <property name="toolTip">
               <string>&lt;p&gt;Upper clip percentile for the intensity normalisation before the 3D U-Net. Intensities above this percentile of the whole movie are set to white. Default 99.98 %. Lower it (e.g. to 99.5–99.9 %) when a few very bright spots make the sarcomeres look dim to the network.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Max:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QDoubleSpinBox" name="dsb_fast_movie_clip_thresh_max">
              <property name="toolTip">
               <string>&lt;p&gt;Upper clip percentile for the intensity normalisation before the 3D U-Net. Intensities above this percentile of the whole movie are set to white. Default 99.98 %. Lower it (e.g. to 99.5–99.9 %) when a few very bright spots make the sarcomeres look dim to the network.&lt;/p&gt;</string>
              </property>
              <property name="maximum">
               <double>99999999.000000000000000</double>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="4" column="0" colspan="2">
           <widget class="QPushButton" name="btn_fast_movie">
            <property name="toolTip">
             <string>&lt;p&gt;Runs the 3D U-Net on every frame of the movie (the frame selection is ignored) and saves its Z-bands. From then on, step 3 and tracking use them instead of the 2D Z-bands, so rerun step 3 afterwards. Step 1 is still needed for M-bands and orientation, and step 2 keeps using the 2D Z-bands. Computationally heavy; a GPU helps a lot.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Detect Z-bands with the 3D U-Net</string>
            </property>
           </widget>
          </item>
        </layout>
       </widget>
      </item>
      <item row="0" column="0">
       <widget class="QLabel" name="label_2">
        <property name="toolTip">
         <string>&lt;p&gt;2D U-Net used in step 1. 'auto' (default) picks a bundled model by pixel size: 'legacy' below 0.08 µm/px (high magnification, e.g. high-speed single-cell movies), the newer 'generalist' otherwise. Type 'generalist', 'generalist_v1' (the previous generalist model) or 'legacy' to force one, or use Browse… for your own trained weights (.pt). The models do not give identical numbers, so use one per study; the model used is saved with the results.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Network model</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="7" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="title">
      <string>Z-band analysis</string>
     </property>
     <layout class="QFormLayout" name="formLayout_3">
      <item row="0" column="0">
       <widget class="QLabel" name="label_3">
        <property name="toolTip">
         <string>&lt;p&gt;Cut-off applied to the Z-band probability map from step 1 (0–1): pixels above it count as Z-band. The resulting mask is split into individual Z-bands, which are then measured and linked. Lower values keep faint Z-bands but can merge neighbours and thicken the mask; higher values keep only clear Z-bands and may break them into pieces. Also sets the Z-band area and intensity. Default 0.5.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Threshold</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_threshold">
        <property name="toolTip">
         <string>&lt;p&gt;Cut-off applied to the Z-band probability map from step 1 (0–1): pixels above it count as Z-band. The resulting mask is split into individual Z-bands, which are then measured and linked. Lower values keep faint Z-bands but can merge neighbours and thicken the mask; higher values keep only clear Z-bands and may break them into pieces. Also sets the Z-band area and intensity. Default 0.5.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="value">
         <double>0.100000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_15">
        <property name="toolTip">
         <string>&lt;p&gt;Z-bands shorter than this, measured along their centre line, are discarded before measuring and linking. Raise it to ignore small specks; lower it to keep the short Z-bands of thin myofibrils. Changes the Z-band count and mean length. Default 0.2 µm.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Min length [µm]</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_min_length">
        <property name="toolTip">
         <string>&lt;p&gt;Z-bands shorter than this, measured along their centre line, are discarded before measuring and linking. Raise it to ignore small specks; lower it to keep the short Z-bands of thin myofibrils. Changes the Z-band count and mean length. Default 0.2 µm.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1000000000000000000000.000000000000000</double>
        </property>
        <property name="value">
         <double>1.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_5">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the median filter that smooths the predicted sarcomere orientation before it is read at the ends of each Z-band. It matters only for very short Z-bands: for all others the direction of each end is taken from the Z-band's own shape. The end directions decide which lateral connections are made. Default 0.2 µm; rarely needs changing.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Median filter radius [µm]</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_median_filter_radius">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the median filter that smooths the predicted sarcomere orientation before it is read at the ends of each Z-band. It matters only for very short Z-bands: for all others the direction of each end is taken from the Z-band's own shape. The end directions decide which lateral connections are made. Default 0.2 µm; rarely needs changing.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_8">
        <property name="toolTip">
         <string>&lt;p&gt;Alignment needed for a lateral connection between two Z-band ends. At each end, the angle between the direction the Z-band points and the straight line to the other end is measured; the cosine of both angles must exceed this value. Default 0.4 allows up to about 66°. Raise it (0.7 ≈ 45°) to accept only connections that continue the Z-band almost straight; lower it to accept kinked ones. Unitless, 0–1.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Theta phi min </string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_theta_phi_min">
        <property name="toolTip">
         <string>&lt;p&gt;Alignment needed for a lateral connection between two Z-band ends. At each end, the angle between the direction the Z-band points and the straight line to the other end is measured; the cosine of both angles must exceed this value. Default 0.4 allows up to about 66°. Raise it (0.7 ≈ 45°) to accept only connections that continue the Z-band almost straight; lower it to accept kinked ones. Unitless, 0–1.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_17">
        <property name="toolTip">
         <string>&lt;p&gt;Minimal linking score for a lateral connection between two Z-band ends (0–1). The score multiplies three cosines: how directly the two ends point at each other, and how well each end points along the connecting line; 1 is a perfectly straight continuation. Pairs below this value are not linked. Of the rest, each end gets at most one partner, chosen so the total score is highest. Higher values give fewer, straighter connections. Default 0.3.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>A min</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_a_min">
        <property name="toolTip">
         <string>&lt;p&gt;Minimal linking score for a lateral connection between two Z-band ends (0–1). The score multiplies three cosines: how directly the two ends point at each other, and how well each end points along the connecting line; 1 is a perfectly straight continuation. Pairs below this value are not linked. Of the rest, each end gets at most one partner, chosen so the total score is highest. Higher values give fewer, straighter connections. Default 0.3.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QLabel" name="label_z_band_max_axial_offset">
        <property name="toolTip">
         <string>&lt;p&gt;How far a lateral connection may be shifted along the sarcomere axis, i.e. perpendicular to the Z-bands. A true connection continues a Z-band sideways to the Z-band of the neighbouring myofibril; one shifted by about half a sarcomere or more reaches the wrong Z-band and is rejected. Lower values accept only Z-bands in close register; higher values tolerate staggered myofibrils. Default 0.9 µm.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Max. axial offset [µm]</string>
        </property>
       </widget>
      </item>
      <item row="8" column="1">
       <widget class="QDoubleSpinBox" name="dsb_z_band_max_axial_offset">
        <property name="toolTip">
         <string>&lt;p&gt;How far a lateral connection may be shifted along the sarcomere axis, i.e. perpendicular to the Z-bands. A true connection continues a Z-band sideways to the Z-band of the neighbouring myofibril; one shifted by about half a sarcomere or more reaches the wrong Z-band and is rejected. Lower values accept only Z-bands in close register; higher values tolerate staggered myofibrils. Default 0.9 µm.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>9999999.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
       </widget>
      </item>
      <item row="9" column="0" colspan="2">
       <widget class="QPushButton" name="btn_structure_z_band">
        <property name="toolTip">
         <string>&lt;p&gt;Step 2. Segments the Z-bands predicted in step 1 (run that first, on the same frames) and measures each one: length, intensity, contrast against its surroundings and orientation. Then links the ends of Z-bands in neighbouring myofibrils into lateral connections. Shows the Z-bands and connections in the viewer. Always uses the 2D Z-bands, even after the 3D U-Net.&lt;/p&gt;</string>
        </property>
        <property name="enabled">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>execute z band analysis, check parameters before</string>
        </property>
        <property name="text">
         <string>2. Analyze Z-bands</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="label_7">
        <property name="toolTip">
         <string>&lt;p&gt;Range of gap lengths, measured end to end, over which two Z-bands can be laterally connected. Only end pairs between Min and Max are considered. Max limits how far a connection may reach across a gap (default 3 µm); Min excludes very close ends (default 0 µm, i.e. off). A connection that would cross a third Z-band is never made.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Distance limits [µm]</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout_8">
        <item>
         <widget class="QLabel" name="label_32">
          <property name="toolTip">
           <string>&lt;p&gt;Smallest gap between two Z-band ends that a lateral connection may bridge; ends closer than this are not connected. Default 0 µm (no lower limit). Rarely changed.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Min:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_z_band_d_min">
          <property name="toolTip">
           <string>&lt;p&gt;Smallest gap between two Z-band ends that a lateral connection may bridge; ends closer than this are not connected. Default 0 µm (no lower limit). Rarely changed.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="maximum">
           <double>99999999.000000000000000</double>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_20">
          <property name="toolTip">
           <string>&lt;p&gt;Largest gap between two Z-band ends that a lateral connection may bridge. Larger values link Z-bands of neighbouring myofibrils across wider gaps, giving longer laterally connected groups, but make wrong links more likely; smaller values only join Z-bands that nearly touch. Default 3 µm.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Max:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_z_band_d_max">
          <property name="toolTip">
           <string>&lt;p&gt;Largest gap between two Z-band ends that a lateral connection may bridge. Larger values link Z-bands of neighbouring myofibrils across wider gaps, giving longer laterally connected groups, but make wrong links more likely; smaller values only join Z-bands that nearly touch. Default 3 µm.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="maximum">
           <double>9999999.000000000000000</double>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item row="8" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox_3">
     <property name="enabled">
      <bool>true</bool>
     </property>
     <property name="title">
      <string>Sarcomere length and orientation analysis</string>
     </property>
     <layout class="QFormLayout" name="formLayout_4">
      <item row="0" column="0">
       <widget class="QLabel" name="label_6">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the area around each M-band point over which the predicted sarcomere orientation is averaged (median). This orientation sets the direction in which the sarcomere length is measured and is the vector's reported orientation. Larger values give a steadier orientation but blur bends and crossings; smaller values follow local detail but are noisier. Default 0.25 µm (at least one pixel).&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Radius [µm]</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="dsb_vectors_radius">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the area around each M-band point over which the predicted sarcomere orientation is averaged (median). This orientation sets the direction in which the sarcomere length is measured and is the vector's reported orientation. Larger values give a steadier orientation but blur bends and crossings; smaller values follow local detail but are noisier. Default 0.25 µm (at least one pixel).&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_18">
        <property name="toolTip">
         <string>&lt;p&gt;Width of the intensity profile drawn through each M-band point to find the two flanking Z-bands; the profile is averaged over this width, sideways along the Z-bands. Wider lines find slightly more vectors but pool neighbouring sarcomeres that differ, run slower and shift the mean length by about 1 %; they do not reduce frame-to-frame noise. Default 0.3 µm. Keep it the same within a study.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Line width [µm]</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="dsb_vectors_line_width">
        <property name="toolTip">
         <string>&lt;p&gt;Width of the intensity profile drawn through each M-band point to find the two flanking Z-bands; the profile is averaged over this width, sideways along the Z-bands. Wider lines find slightly more vectors but pool neighbouring sarcomeres that differ, run slower and shift the mean length by about 1 %; they do not reduce frame-to-frame noise. Default 0.3 µm. Keep it the same within a study.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>9999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_21">
        <property name="toolTip">
         <string>&lt;p&gt;How finely each intensity profile is resampled before the Z-band peaks are located: the number of points is multiplied by this factor (smooth Akima interpolation). Higher values locate the peaks, and so the sarcomere length, more finely between pixels, but take longer. Default 4; 0 or 1 keeps the original sampling.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Interpolation factor</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="sb_vectors_interpolation_factor">
        <property name="toolTip">
         <string>&lt;p&gt;How finely each intensity profile is resampled before the Z-band peaks are located: the number of points is multiplied by this factor (smooth Akima interpolation). Higher values locate the peaks, and so the sarcomere length, more finely between pixels, but take longer. Default 4; 0 or 1 keeps the original sampling.&lt;/p&gt;</string>
        </property>
        <property name="maximum">
         <number>99999999</number>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_23">
        <property name="toolTip">
         <string>&lt;p&gt;Range of sarcomere lengths accepted. At each M-band point the distance between the two flanking Z-bands is measured; vectors whose length falls outside Min to Max are discarded. Max also sets how long the measuring profile is (1.3 × Max). Defaults 1.0 to 3.0 µm. Widen the range for strongly stretched sarcomeres; narrow it to drop implausible lengths.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Length limits [µm]</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout_5">
        <item>
         <widget class="QLabel" name="label_25">
          <property name="toolTip">
           <string>&lt;p&gt;Shortest sarcomere length accepted; shorter vectors are discarded. Default 1.0 µm. The Z-band peak search never accepts peaks less than 1 µm apart, so setting this clearly below 1 µm has no effect.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Min:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_vectors_len_lims_min">
          <property name="toolTip">
           <string>&lt;p&gt;Shortest sarcomere length accepted; shorter vectors are discarded. Default 1.0 µm. The Z-band peak search never accepts peaks less than 1 µm apart, so setting this clearly below 1 µm has no effect.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="maximum">
           <double>10000.000000000000000</double>
          </property>
          <property name="value">
           <double>1.000000000000000</double>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_24">
          <property name="toolTip">
           <string>&lt;p&gt;Longest sarcomere length accepted; longer vectors are discarded. It also sets the length of the measuring profile (1.3 × Max), so a much larger value slows the analysis. Default 3.0 µm.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Max:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="dsb_vectors_len_lims_max">
          <property name="toolTip">
           <string>&lt;p&gt;Longest sarcomere length accepted; longer vectors are discarded. It also sets the length of the measuring profile (1.3 × Max), so a much larger value slows the analysis. Default 3.0 µm.&lt;/p&gt;</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="maximum">
           <double>10000.000000000000000</double>
          </property>
          <property name="value">
           <double>4.000000000000000</double>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_vectors_smooth_sigma">
        <property name="toolTip">
         <string>&lt;p&gt;Smooths the predicted sarcomere orientation over time (Gaussian, sigma in frames) before the vectors are extracted, which reduces frame-to-frame jitter of the orientation; it hardly changes lengths. Only for high-speed movies in which consecutive frames show the same sarcomeres; leave it at 0 for time-lapse recordings. It smooths across the selected frames, so select a continuous range. 0 = off (default).&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Temporal orient. smoothing [frames]</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="dsb_vectors_smooth_orientation_sigma">
        <property name="toolTip">
         <string>&lt;p&gt;Smooths the predicted sarcomere orientation over time (Gaussian, sigma in frames) before the vectors are extracted, which reduces frame-to-frame jitter of the orientation; it hardly changes lengths. Only for high-speed movies in which consecutive frames show the same sarcomeres; leave it at 0 for time-lapse recordings. It smooths across the selected frames, so select a continuous range. 0 = off (default).&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="value">
         <double>0.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="label_vectors_filter_neighbors">
        <property name="toolTip">
         <string>&lt;p&gt;Removes sarcomere vectors whose orientation disagrees with the vectors around them: typically M-band fragments where differently oriented myofibrils cross, and stray detections. Each vector is compared with the average orientation of the vectors within 'Neighbour radius' and removed if it deviates by more than 'Max. neighbour deviation'; vectors without neighbours are kept. With the defaults this removes about 0–2 % of vectors. On by default.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Remove outlier vectors</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QCheckBox" name="chk_vectors_filter_neighbors">
        <property name="toolTip">
         <string>&lt;p&gt;Removes sarcomere vectors whose orientation disagrees with the vectors around them: typically M-band fragments where differently oriented myofibrils cross, and stray detections. Each vector is compared with the average orientation of the vectors within 'Neighbour radius' and removed if it deviates by more than 'Max. neighbour deviation'; vectors without neighbours are kept. With the defaults this removes about 0–2 % of vectors. On by default.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="label_vectors_neighbor_radius">
        <property name="toolTip">
         <string>&lt;p&gt;Size of the circle around each sarcomere vector that the outlier check looks at. There is one vector on every pixel of an M-band midline, so the circle holds the rest of the vector's own M-band and parts of nearby ones; their average orientation is what the vector is compared with.&lt;/p&gt;&lt;p&gt;A larger radius takes in more surrounding myofibrils, so stray fragments lying across them are removed more readily, but so can correct vectors where myofibrils bend sharply. A smaller radius sees mostly the vector's own M-band and removes fewer. Vectors without neighbours are always kept. Default 1 µm, about one M-band length. Only used when 'Remove outlier vectors' is on.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Neighbour radius [µm]</string>
        </property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QDoubleSpinBox" name="dsb_vectors_neighbor_radius">
        <property name="toolTip">
         <string>&lt;p&gt;Size of the circle around each sarcomere vector that the outlier check looks at. There is one vector on every pixel of an M-band midline, so the circle holds the rest of the vector's own M-band and parts of nearby ones; their average orientation is what the vector is compared with.&lt;/p&gt;&lt;p&gt;A larger radius takes in more surrounding myofibrils, so stray fragments lying across them are removed more readily, but so can correct vectors where myofibrils bend sharply. A smaller radius sees mostly the vector's own M-band and removes fewer. Vectors without neighbours are always kept. Default 1 µm, about one M-band length. Only used when 'Remove outlier vectors' is on.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.250000000000000</double>
        </property>
        <property name="value">
         <double>1.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="label_vectors_max_neighbor_deviation">
        <property name="toolTip">
         <string>&lt;p&gt;How far, in degrees, a vector's orientation may differ from the average orientation of its neighbours (the vectors within 'Neighbour radius') before it is removed. Lower values are stricter: more false vectors at myofibril crossings go, but so do correct vectors in disordered or sharply bending regions. Higher values remove fewer; 90° removes none. Default 30°. Only used when 'Remove outlier vectors' is on; the number removed per frame is saved as n_vectors_removed.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Max. neighbour deviation [°]</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QDoubleSpinBox" name="dsb_vectors_max_neighbor_deviation">
        <property name="toolTip">
         <string>&lt;p&gt;How far, in degrees, a vector's orientation may differ from the average orientation of its neighbours (the vectors within 'Neighbour radius') before it is removed. Lower values are stricter: more false vectors at myofibril crossings go, but so do correct vectors in disordered or sharply bending regions. Higher values remove fewer; 90° removes none. Default 30°. Only used when 'Remove outlier vectors' is on; the number removed per frame is saved as n_vectors_removed.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="maximum">
         <double>90.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>5.000000000000000</double>
        </property>
        <property name="value">
         <double>30.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="8" column="0" colspan="2">
       <widget class="QPushButton" name="btn_structure_vectors">
        <property name="toolTip">
         <string>&lt;p&gt;Step 3. Places a sarcomere vector on every pixel of the M-band midlines from step 1 (run that first, on the same frames) and measures there the sarcomere length (distance between the two flanking Z-bands) and orientation, then removes outliers if selected. Uses the 3D U-Net Z-bands if they exist. Shows the vectors in the viewer. Needed for myofibrils, domains and motion analysis. Takes a while on long movies.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>3. Analyze sarcomere vectors</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="9" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox_5">
     <property name="title">
      <string>Myofibril analysis</string>
     </property>
     <layout class="QFormLayout" name="formLayout_6">
      <item row="1" column="0">
       <widget class="QLabel" name="label_35">
        <property name="toolTip">
         <string>&lt;p&gt;Fraction of sarcomere vectors picked at random as starting points for myofibril lines; from each one a line is grown in both directions, sarcomere by sarcomere. More seeds find more myofibrils, including short ones, but take longer and give more overlapping lines on the same myofibril. Default 0.1 (10 %). Seeds are random, so repeated runs can differ slightly.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Ratio Seeds</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_37">
        <property name="toolTip">
         <string>&lt;p&gt;Number of sarcomeres at the growing end of a line whose lengths and orientations are averaged to predict where the next sarcomere should be. Higher values give straighter lines that ignore single noisy vectors but cut corners at bends; lower values follow curved myofibrils but stray more easily. Default 3.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Persistence</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="sb_myofibril_persistence">
        <property name="toolTip">
         <string>&lt;p&gt;Number of sarcomeres at the growing end of a line whose lengths and orientations are averaged to predict where the next sarcomere should be. Higher values give straighter lines that ignore single noisy vectors but cut corners at bends; lower values follow curved myofibrils but stray more easily. Default 3.&lt;/p&gt;</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="toolTip">
         <string>Persistence of line (average length and orientation for prior estimation)</string>
        </property>
        <property name="maximum">
         <number>10</number>
        </property>
        <property name="value">
         <number>3</number>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_38">
        <property name="toolTip">
         <string>&lt;p&gt;How far the nearest sarcomere vector may lie from the predicted position of the next sarcomere for a myofibril line to continue. Larger values bridge small gaps and misalignments but may jump to a neighbouring myofibril; smaller values stop lines earlier, giving shorter myofibrils. Default 0.5 µm.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Threshold distance [µm]</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="dsb_myofibril_thresh_dist">
        <property name="toolTip">
         <string>&lt;p&gt;How far the nearest sarcomere vector may lie from the predicted position of the next sarcomere for a myofibril line to continue. Larger values bridge small gaps and misalignments but may jump to a neighbouring myofibril; smaller values stop lines earlier, giving shorter myofibrils. Default 0.5 µm.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>100000000.000000000000000</double>
        </property>
        <property name="value">
         <double>0.300000000000000</double>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_22">
        <property name="toolTip">
         <string>&lt;p&gt;Minimum number of sarcomeres in a myofibril line; shorter lines are discarded. Raising it ignores short fragments and so raises the reported myofibril lengths; lowering it keeps the short myofibrils of immature or disordered cells. Default 4.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>N min</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="sb_myofibril_n_min">
        <property name="toolTip">
         <string>&lt;p&gt;Minimum number of sarcomeres in a myofibril line; shorter lines are discarded. Raising it ignores short fragments and so raises the reported myofibril lengths; lowering it keeps the short myofibrils of immature or disordered cells. Default 4.&lt;/p&gt;</string>
        </property>
        <property name="maximum">
         <number>10000008</number>
        </property>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QPushButton" name="btn_structure_myofibril">
        <property name="toolTip">
         <string>&lt;p&gt;Step 4. Grows myofibril lines through the sarcomere vectors of step 3 (run that first) by stepping from sarcomere to sarcomere along the sarcomere axis, then measures the length and bending of each myofibril. Shows the lines in the viewer.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>4. Analyze myofibrils</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="dsb_myofibril_ratio_seeds">
        <property name="toolTip">
         <string>&lt;p&gt;Fraction of sarcomere vectors picked at random as starting points for myofibril lines; from each one a line is grown in both directions, sarcomere by sarcomere. More seeds find more myofibrils, including short ones, but take longer and give more overlapping lines on the same myofibril. Default 0.1 (10 %). Seeds are random, so repeated runs can differ slightly.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>9999999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="label_41">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the median filter that smooths the myofibril length map (an image in which the pixels along each myofibril line carry that line's length) before the mean, SD and maximum myofibril length are taken from it. Larger values smooth more. Default 0.5 µm.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Median filter radius [µm]</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="dsb_myofibril_median_filter_radius">
        <property name="toolTip">
         <string>&lt;p&gt;Radius of the median filter that smooths the myofibril length map (an image in which the pixels along each myofibril line carry that line's length) before the mean, SD and maximum myofibril length are taken from it. Larger values smooth more. Default 0.5 µm.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="10" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox_4">
     <property name="title">
      <string>Domain analysis</string>
     </property>
     <layout class="QFormLayout" name="formLayout_5">
      <item row="0" column="0">
       <widget class="QLabel" name="label">
        <property name="toolTip">
         <string>&lt;p&gt;Maximum distance for linking sarcomere vectors into a network. Each vector has two ends, at its two Z-bands; ends of different vectors closer than this are linked if their orientations are similar (see 'Cosine min'), and domains are then found as densely linked groups. Larger values link across wider gaps and take longer; smaller values break the network at gaps, so regions separated by one cannot form one domain. Default 3 µm.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>D max </string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="dsb_domains_d_max">
        <property name="toolTip">
         <string>&lt;p&gt;Maximum distance for linking sarcomere vectors into a network. Each vector has two ends, at its two Z-bands; ends of different vectors closer than this are linked if their orientations are similar (see 'Cosine min'), and domains are then found as densely linked groups. Larger values link across wider gaps and take longer; smaller values break the network at gaps, so regions separated by one cannot form one domain. Default 3 µm.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>9999995.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_16">
        <property name="toolTip">
         <string>&lt;p&gt;How similar two sarcomere vectors must be in orientation to be linked: the absolute cosine of the angle between them must exceed this value. Default 0.65, i.e. up to about 49°. Higher values link only nearly parallel vectors, so domains are more uniform in orientation and break up at bends; lower values merge regions of different orientation. Unitless, 0–1.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Cosine min</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="dsb_domains_cosine_min">
        <property name="toolTip">
         <string>&lt;p&gt;How similar two sarcomere vectors must be in orientation to be linked: the absolute cosine of the angle between them must exceed this value. Default 0.65, i.e. up to about 49°. Higher values link only nearly parallel vectors, so domains are more uniform in orientation and break up at bends; lower values merge regions of different orientation. Unitless, 0–1.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_19">
        <property name="toolTip">
         <string>&lt;p&gt;Sets the typical domain size in the community detection (Leiden algorithm). Higher values split the network into more, smaller domains; lower values give fewer, larger ones. Default 0.06. Increase it if a domain spans regions you would call separate; decrease it if uniform regions are cut up.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Leiden resolution</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="dsb_domains_leiden_resolution">
        <property name="toolTip">
         <string>&lt;p&gt;Sets the typical domain size in the community detection (Leiden algorithm). Higher values split the network into more, smaller domains; lower values give fewer, larger ones. Default 0.06. Increase it if a domain spans regions you would call separate; decrease it if uniform regions are cut up.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>99999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_26">
        <property name="toolTip">
         <string>&lt;p&gt;Smallest domain kept, in µm². A domain's area is the area its sarcomere vectors cover, drawn as lines of their sarcomere length and widened by 'Dilation radius'. Smaller domains, and any with 10 or fewer vectors, are discarded. Default 20 µm².&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Area min [µm²]</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="dsb_domains_area_min">
        <property name="toolTip">
         <string>&lt;p&gt;Smallest domain kept, in µm². A domain's area is the area its sarcomere vectors cover, drawn as lines of their sarcomere length and widened by 'Dilation radius'. Smaller domains, and any with 10 or fewer vectors, are discarded. Default 20 µm².&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>9999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_27">
        <property name="toolTip">
         <string>&lt;p&gt;Starting value of the random number generator for the Leiden algorithm, whose result depends on chance. The same seed gives the same domains every time; a different seed can give slightly different domains, which is a quick way to check that a result is robust. Default 42.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Random seed</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="sb_domains_random_seed">
        <property name="toolTip">
         <string>&lt;p&gt;Starting value of the random number generator for the Leiden algorithm, whose result depends on chance. The same seed gives the same domains every time; a different seed can give slightly different domains, which is a quick way to check that a result is robust. Default 42.&lt;/p&gt;</string>
        </property>
        <property name="maximum">
         <number>999999999</number>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="label_28">
        <property name="toolTip">
         <string>&lt;p&gt;How much each domain's sarcomere vectors are widened when its area mask is drawn. Larger values close gaps between vectors and give larger, smoother domain areas, so more domains pass 'Area min'; smaller values follow the vectors closely. Default 0.3 µm. It changes the reported domain areas, so keep it fixed within a study.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Dilation radius</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="dsb_domains_dilation_radius">
        <property name="toolTip">
         <string>&lt;p&gt;How much each domain's sarcomere vectors are widened when its area mask is drawn. Larger values close gaps between vectors and give larger, smoother domain areas, so more domains pass 'Area min'; smaller values follow the vectors closely. Default 0.3 µm. It changes the reported domain areas, so keep it fixed within a study.&lt;/p&gt;</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>999999999.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QPushButton" name="btn_structure_domain_analysis">
        <property name="toolTip">
         <string>&lt;p&gt;Step 5. Groups the sarcomere vectors of step 3 (run that first) into domains of similar orientation: nearby, similarly oriented vectors are linked into a network, which the Leiden algorithm splits into communities. Measures area, mean sarcomere length, main orientation and orientational order of each domain. Shows the domains in the viewer.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>5. Analyze domains</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="11" column="0" colspan="2">
    <widget class="QPushButton" name="btn_export_structure_data">
     <property name="toolTip">
      <string>&lt;p&gt;Opens a dialog to choose which structure results to export. Summary mode writes one value per metric and frame (.csv, .xlsx or .json); full mode writes every individual value, e.g. of each sarcomere vector, as .json. Run the analysis steps first.&lt;/p&gt;</string>
     </property>
     <property name="text">
      <string>Export Structure Data (.csv/.xlsx)</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
